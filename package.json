{
    "name": "iobroker.energyflow",
    "version": "0.0.1",
    "description": "Configurable energy flow diagram for ioBroker.vis-2 and ioBroker.devices",
    "author": "bluefox <dogafox@gmail.com>",
    "contributors": [
        "bluefox <dogafox@gmail.com>"
    ],
    "homepage": "https://github.com/ioBroker/ioBroker.energyflow",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/ioBroker/ioBroker.energyflow"
    },
    "keywords": [
        "ioBroker",
        "visualisation",
        "energy",
        "energyflow",
        "photovoltaics",
        "vis-2",
        "devices"
    ],
    "workspaces": [
        "src-widgets",
        "src-dm-widgets"
    ],
    "devDependencies": {
        "@alcalzone/release-script": "^5.2.1",
        "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
        "@alcalzone/release-script-plugin-license": "^5.2.2",
        "@emotion/react": "^11.14.0",
        "@iobroker/build-tools": "^3.0.3",
        "@iobroker/eslint-config": "^2.3.4",
        "@iobroker/gui-components": "^10.2.3",
        "@iobroker/testing": "^5.3.0",
        "@iobroker/types": "^7.2.2",
        "@iobroker/types-vis-2": "~2.20.1",
        "@mui/icons-material": "^9.4.0",
        "@mui/material": "^9.4.0",
        "@mui/system": "^9.4.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "^26.4.1",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.3.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "tsx": "^4.21.1",
        "typescript": "~6.0.3"
    },
    "files": [
        "admin/",
        "widgets/",
        "io-package.json",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsx tasks.ts",
        "build-vis": "tsx tasks.ts --vis",
        "build-dm": "tsx tasks.ts --dm",
        "previews": "tsx tools/generatePreviews.tsx",
        "gallery": "tsx tools/gallery.tsx",
        "check": "tsc --noEmit -p tsconfig.json",
        "lint": "eslint -c eslint.config.mjs",
        "test": "mocha",
        "prepublishOnly": "npm run build",
        "release": "release-script",
        "release-patch": "release-script patch --yes",
        "release-minor": "release-script minor --yes",
        "release-major": "release-script major --yes",
        "update-packages": "npx -y npm-check-updates --upgrade --workspaces --root"
    },
    "bugs": {
        "url": "https://github.com/ioBroker/ioBroker.energyflow/issues"
    },
    "readmeFilename": "README.md"
}
