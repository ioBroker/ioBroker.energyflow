{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "lib": ["DOM", "DOM.Iterable", "ESNext"],
        "noEmit": true,
        "skipLibCheck": true,
        "allowJs": true,
        "checkJs": false,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "types": ["node", "mocha", "@iobroker/types"],
        "paths": {
            "@energyflow/core": ["./packages/core/src/index.ts"],
            "@energyflow/core/*": ["./packages/core/src/*"],
            "@energyflow/editor": ["./packages/editor/src/index.ts"],
            "@energyflow/editor/*": ["./packages/editor/src/*"],
            "@energyflow/i18n": ["./packages/i18n/src/index.ts"]
        }
    },
    "include": ["packages/*/src/**/*", "tasks.ts", "tools/**/*", "test/**/*", "*.mjs"],
    "exclude": ["node_modules", "**/node_modules", "**/build", "widgets", "tmp"]
}
